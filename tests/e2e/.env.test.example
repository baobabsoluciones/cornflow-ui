# Playwright E2E Test Environment Variables
# Copy this file to .env.test and fill in your values

# ============================================
# Playwright Configuration
# ============================================
# Base URL for the frontend application
PLAYWRIGHT_BASE_URL=http://localhost:5173

# Backend URL for API calls
PLAYWRIGHT_BACKEND_URL=http://localhost:5000

# Authentication type for tests (cornflow, azure, cognito)
PLAYWRIGHT_AUTH_TYPE=cornflow

# Test user credentials
PLAYWRIGHT_TEST_USER=test@example.com
PLAYWRIGHT_TEST_PASSWORD=testpassword123

# ============================================
# Application Configuration (VITE_APP_*)
# These are used by the Vue application during tests
# ============================================

# Core configuration
VITE_APP_BACKEND_URL=http://localhost:5000
VITE_APP_SCHEMA=test_schema
VITE_APP_NAME=Test Application

# Application behavior
VITE_APP_EXTERNAL_APP=false
VITE_APP_IS_STAGING_ENVIRONMENT=false
VITE_APP_USE_HASH_MODE=false
VITE_APP_DEFAULT_LANGUAGE=es
VITE_APP_IS_DEVELOPER_MODE=false
VITE_APP_ENABLE_SIGNUP=false

# Authentication configuration
VITE_APP_AUTH_TYPE=cornflow
# VITE_APP_AUTH_CLIENT_ID=your-client-id
# VITE_APP_AUTH_AUTHORITY=your-authority
# VITE_APP_AUTH_REDIRECT_URI=your-redirect-uri
# VITE_APP_AUTH_REGION=your-region
# VITE_APP_AUTH_USER_POOL_ID=your-user-pool-id
# VITE_APP_AUTH_DOMAIN=your-domain
# VITE_APP_AUTH_PROVIDERS=google,microsoft
