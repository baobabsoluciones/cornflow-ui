# ──────────────────────────────────────────────
# Test authentication credentials
# ──────────────────────────────────────────────
PLAYWRIGHT_TEST_USER=your_user
PLAYWRIGHT_TEST_PASSWORD=your_password

# Only set this against a throwaway account: it enables the change-password
# tests, which mutate the account.
# PLAYWRIGHT_TEST_TEMP_PASSWORD=your_temporary_password

# Authentication type (optional, defaults to 'cornflow')
# Possible values: 'cornflow', 'azure', 'cognito' — use cornflow, SSO is not reliable in CI.
PLAYWRIGHT_AUTH_TYPE=cornflow

# Application base URL (optional, defaults to 'http://localhost:3000')
PLAYWRIGHT_BASE_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Backend the app runs against (VITE_APP_*)
# IMPORTANT: use VITE_APP_BACKEND_URL (not VITE_APP_API_URL).
# Note: Vite does NOT read this file — the app takes its configuration from the root `.env`.
# Keep both pointing at the same environment.
# ──────────────────────────────────────────────
VITE_APP_BACKEND_URL=http://localhost:5000
VITE_APP_SCHEMA=your_schema
VITE_APP_AUTH_TYPE=cornflow
# ... any other VITE_APP_* variable your application needs
