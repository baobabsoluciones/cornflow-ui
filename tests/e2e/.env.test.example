# Copy to tests/e2e/.env.test (gitignored). The config factory loads it; the shell can set the
# same variables instead.

# The user the suite signs in as. In "disposable" mode (tests/e2e/uat.json) it has to be an admin:
# the suite creates a user per role with it, and deletes them at the end.
E2E_USER=your_user
E2E_PASSWORD=your_password

# Only if that user has two-factor authentication on (Cornflow 1.4; required there unless the
# server turns it off): the secret of its authenticator, the text its QR code holds. The suite
# makes its codes with it. The users the suite creates turn it on themselves when asked.
# E2E_TOTP_SECRET=YOUR_BASE32_SECRET

# The suite prepares and cleans up its data on the backend the app says it talks to
# (describe().backendUrl). Optional: another address to reach that same backend from here.
# E2E_BACKEND_URL=https://your-backend.example.com

# Optional: where the app under test is served (defaults to the one the config starts).
# PLAYWRIGHT_BASE_URL=http://localhost:3000

# Optional: another UAT file than tests/e2e/uat.json.
# E2E_UAT_FILE=tests/e2e/uat.pre.json

# Any other VITE_APP_* variable the app needs, if it is not in the app's .env already.
