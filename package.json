{
  "name": "@cornflow-ui/core",
  "private": true,
  "version": "3.2.4",
  "type": "module",
  "files": [
    "src",
    "tests/e2e"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/assets/styles/main.css",
    "./e2e/*": "./tests/e2e/*",
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test --config=tests/e2e/playwright.config.ts",
    "test:e2e:headed": "playwright test --config=tests/e2e/playwright.config.ts --headed",
    "test:e2e:ui": "playwright test --config=tests/e2e/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config=tests/e2e/playwright.config.ts --debug",
    "test:e2e:send-report": "npx tsx tests/e2e/reporters/send-report.ts",
    "test:e2e:full": "npm run test:e2e && npm run test:e2e:send-report || npm run test:e2e:send-report"
  },
  "dependencies": {
    "@aws-amplify/auth": "6.20.0",
    "@aws-amplify/core": "6.16.4",
    "@azure/msal-browser": "5.11.0",
    "@mdi/font": "7.4.47",
    "@types/webfontloader": "1.6.38",
    "ajv": "8.20.0",
    "aws-amplify": "6.17.0",
    "dompurify": "3.4.13",
    "exceljs": "4.4.0",
    "jsonschema": "1.5.0",
    "jszip": "^3.10.1",
    "leaflet": "1.9.4",
    "mango-vue": "0.2.7",
    "markdown-it": "14.2.0",
    "pinia": "3.0.4",
    "prettier": "3.8.5",
    "read-excel-file": "5.8.8",
    "vite-plugin-vuetify": "2.1.3",
    "vue": "3.5.39",
    "vue-i18n": "11.4.6",
    "vue-router": "5.1.0",
    "vue3-marquee": "4.2.2",
    "vuetify": "3.9.7",
    "webfontloader": "1.6.28",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "glob": "^10.5.0",
    "@smithy/config-resolver": "^4.4.0",
    "editorconfig": {
      "minimatch": "^9.0.9"
    },
    "uuid": "14.0.0",
    "fast-xml-parser": "5.7.0",
    "@xmldom/xmldom": "0.9.10"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "25.9.4",
    "@types/nodemailer": "^7.0.9",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/coverage-v8": "4.1.9",
    "@vue/test-utils": "2.4.11",
    "dotenv": "17.4.2",
    "jsdom": "29.1.1",
    "nodemailer": "^9.0.5",
    "rollup": "4.61.1",
    "sass": "1.100.0",
    "typescript": "6.0.3",
    "tsx": "^4.21.0",
    "vite": "8.0.16",
    "vitest": "4.1.9",
    "vue-tsc": "3.3.5"
  }
}
